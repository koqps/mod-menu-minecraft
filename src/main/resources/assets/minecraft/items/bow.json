                "model": {
                  "type": "minecraft:special",
                  "base": "topka:item/valentine_bow_base",
                  "model": {
                    "type": "topka:weapon_mesh",
                    "pack": "valentine",
                    "model": "bow_2",
                    "scale": 1,
                    "rx": 0,
                    "ry": 0,
                    "rz": 0
                  }
                }
              }
            ],
            "fallback": {
